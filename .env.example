# ============================================
# Customer Service Platform - Environment Variables
# ============================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local (for local development)
# 2. Fill in your actual values (never commit .env.local to git)
# 3. In production, set these as environment variables in your hosting platform
#
# NOTE: .env.local is automatically loaded by Next.js and ignored by git

# ============================================
# NextAuth.js Configuration (Required in Production)
# ============================================
# Generate a secret: openssl rand -base64 32
# This intentionally fails production validation until replaced.
AUTH_SECRET=replace-me

# Base URL for NextAuth callbacks (optional, auto-detected in most cases)
# NEXTAUTH_URL=http://localhost:3010

# ============================================
# Production Fallback User (Optional)
# ============================================
# Use when mock auth is disabled and real auth is not yet configured
# AUTH_DEFAULT_USER_EMAIL=support@example.com
# AUTH_DEFAULT_USER_PASSWORD=strong-password-here
# AUTH_DEFAULT_USER_ROLE=staff
# AUTH_DEFAULT_USER_NAME=Support Agent
# AUTH_DEFAULT_USER_REGION=asia-pacific

# ============================================
# Mock Authentication (Development Only)
# ============================================
# Production rejects mock authentication even when this is set to true.
# In development and test, mock auth is enabled by the current implementation.
# NEXT_PUBLIC_ENABLE_MOCK_AUTH=false

# ============================================
# Database Configuration
# ============================================
# PostgreSQL (required). Use a dedicated development database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_service_dev

# ============================================
# Zammad Integration (Required)
# ============================================
# Intentionally unreachable placeholder. Replace only with the intended environment.
ZAMMAD_URL=http://127.0.0.1:65535/

# Zammad API token with admin permissions
# Create at: Zammad Admin > System > API > New API Token
ZAMMAD_API_TOKEN=replace-me

# Zammad Webhook Secret (for verifying incoming webhooks)
# Set this to the same value as the Signature Token in Zammad Webhook config
ZAMMAD_WEBHOOK_SECRET=replace-me

# ============================================
# Scheduled Jobs (Optional)
# ============================================
# Protects /api/tickets/auto-assign when scheduled externally.
# CRON_SECRET=replace-with-a-random-secret

# Prefer one uniquely eligible email CC recipient for initial ticket assignment.
# Disabled unless explicitly set to true; CC display is unaffected.
# EMAIL_CC_AUTO_ASSIGN_ENABLED=false

# ============================================
# AI Configuration (Optional)
# ============================================
# FastGPT / OpenAI-compatible / Yuxi credentials
# FASTGPT_API_KEY=
# AI_FASTGPT_API_KEY=
# FASTGPT_PRO_APP_ID=
# FASTGPT_PRO_API_KEY=
# AI_FASTGPT_PRO_APP_ID=
# AI_FASTGPT_PRO_API_KEY=
# AI_OPENAI_API_KEY=
# AI_YUXI_USERNAME=
# AI_YUXI_PASSWORD=

# AI SSE transport protection. The idle watchdog measures provider data only;
# heartbeat comments keep reverse proxies alive without extending that watchdog.
# AI_STREAM_IDLE_TIMEOUT_MS=180000
# AI_STREAM_HEARTBEAT_INTERVAL_MS=15000

# Protects staff AI QA retest calls when configured.
# AI_QA_RETEST_KEY=

# ============================================
# Logging Configuration (Optional)
# ============================================
# Log level: debug, info, warn (or warning), error
# NOTE: Client-side logs can only read NEXT_PUBLIC_* variables.
# If you want browser console INFO logs in production builds, set NEXT_PUBLIC_LOG_LEVEL too.
LOG_LEVEL=info
# NEXT_PUBLIC_LOG_LEVEL=info

# ============================================
# File Logging Configuration (Optional)
# ============================================
# Enable file-based log persistence (default: false)
# LOG_TO_FILE=true

# Directory for log files (default: ./logs)
# LOG_DIR=./logs

# Log file prefix (default: app)
# LOG_FILE_PREFIX=app

# Maximum log file size in bytes before rotation (default: 10485760 = 10MB)
# LOG_MAX_FILE_SIZE=10485760

# Number of days to retain log files (default: 30)
# LOG_RETENTION_DAYS=30

# ============================================
# File Storage Buckets (Optional)
# ============================================
# STORAGE_BUCKET_AVATARS=avatars
# STORAGE_BUCKET_MESSAGE_ATTACHMENTS=message-attachments
# STORAGE_BUCKET_TICKET_ATTACHMENTS=ticket-attachments

# ============================================
# Server Binding (Optional)
# ============================================
# PORT=3010
# HOST=0.0.0.0

# ============================================
# Email User Welcome Configuration (Optional)
# ============================================
# Auto-generate password for first-time email users (default: true)
# EMAIL_USER_AUTO_PASSWORD_ENABLED=true

# Send welcome email with login credentials (default: true)
# EMAIL_USER_WELCOME_EMAIL_ENABLED=true

# Web platform URL for login links. Required in production unless welcome email is disabled.
# WEB_PLATFORM_URL=https://support.example.com
